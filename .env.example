# --- Database ---
DATABASE_URL=postgresql+asyncpg://ecom:ecom@127.0.0.1:5432/ecom
DATABASE_URL_SYNC=postgresql+psycopg2://ecom:ecom@127.0.0.1:5432/ecom

# --- Sessions & CSRF ---
SESSION_COOKIE_NAME=sid
SESSION_TTL_DAYS=14
SESSION_SECRET=change-me-please-32-bytes-minimum-secret
CSRF_COOKIE_NAME=csrf
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Auth / OTP ---
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_EMAIL_PER_MIN=3
OTP_RATE_LIMIT_PER_IP_PER_MIN=10

# --- Email (console = print to stdout; smtp = real send) ---
EMAIL_BACKEND=console
MAIL_HOST=zmail.emtechhouse.co.ke
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USERNAME=Banca-noreply@emtechhouse.co.ke
MAIL_PASSWORD=
MAIL_FROM=Banca-noreply@emtechhouse.co.ke
MAIL_FROM_NAME=Ecomsolution

# --- M-Pesa Daraja ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads

# --- Locale ---
CURRENCY=KES
DEFAULT_COUNTRY=KE
APP_NAME=Ecomsolution
DEBUG=true
